<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Claims | Campus Lost &amp; Found</title>
  <link rel="stylesheet" href="/css/app.css?v=11">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="records-shell">
    <%
      const claimList = typeof claims !== 'undefined' && Array.isArray(claims) ? claims : [];
      const countStatus = function(value) {
        return claimList.filter(function(claim) {
          return String(claim.status || 'Pending').toLowerCase() === value.toLowerCase();
        }).length;
      };
    %>

    <section class="records-page-heading claims-page-heading">
      <div>
        <p class="page-eyebrow"><span></span> Claim activity</p>
        <h1>My claims</h1>
        <p>Track your requests and follow the review status for items you believe are yours.</p>
      </div>
      <a href="/browse" class="page-primary-button">Browse found items <span aria-hidden="true">→</span></a>
    </section>

    <section class="records-summary" aria-label="Claim summary">
      <article class="records-summary-card records-summary-total">
        <span class="records-summary-mark" aria-hidden="true">01</span>
        <div><p>Total claims</p><strong><%= claimList.length %></strong></div>
      </article>
      <article class="records-summary-card records-summary-pending">
        <span class="records-summary-mark" aria-hidden="true">02</span>
        <div><p>Awaiting review</p><strong><%= countStatus('pending') %></strong></div>
      </article>
      <article class="records-summary-card records-summary-approved">
        <span class="records-summary-mark" aria-hidden="true">03</span>
        <div><p>Approved claims</p><strong><%= countStatus('approved') %></strong></div>
      </article>
    </section>

    <section class="table-wrap records-table-wrap">
      <% if (claimList.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Claim Date</th>
              <th>Status</th>
              <th>Verification Details</th>
              <th>View</th>
            </tr>
          </thead>
          <tbody>
            <% claimList.forEach(function(claim) {
              const status = String(claim.status || 'Pending');
              const statusClass = ['pending', 'approved', 'rejected'].includes(status.toLowerCase())
                ? status.toLowerCase() : 'other';
              const itemId = claim.item_id || claim.itemId || claim.id_item;
              const claimDate = claim.created_at || claim.claim_date || claim.submitted_at;
            %>
              <tr>
                <td>
                  <div class="item-name"><%= claim.item_name || claim.title || 'Claimed Item' %></div>
                  <div class="muted">Claim ID: <%= claim.claim_id || claim.id || 'N/A' %></div>
                </td>
                <td><%= claimDate ? new Date(claimDate).toLocaleDateString() : 'Not available' %></td>
                <td><span class="badge <%= statusClass %>"><%= status %></span></td>
                <td class="claim-verification"><%= claim.verification_answer || claim.verification_details || 'Submitted' %></td>
                <td>
                  <% if (itemId) { %>
                    <a class="view-link" href="/item/<%= itemId %>">View item →</a>
                  <% } else { %>
                    <span class="muted">Unavailable</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="records-empty-state">
          <span class="records-empty-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 21s-8-4.6-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.4-8 11-8 11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <h2>No claims yet</h2>
          <p>When you submit a claim for a found item, its details and status will appear here.</p>
          <a href="/browse" class="page-primary-button">Browse found items <span aria-hidden="true">→</span></a>
        </div>
      <% } %>
    </section>
  </main>

  <footer>© Campus Lost &amp; Found System</footer>
</body>
</html>
