<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Reports | Campus Lost &amp; Found</title>
  <link rel="stylesheet" href="/css/app.css?v=5">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="records-shell">
    <%
      const reportList = typeof reports !== 'undefined' && Array.isArray(reports)
        ? reports
        : (typeof items !== 'undefined' && Array.isArray(items) ? items : []);
      const reportStatusCount = function(value) {
        return reportList.filter(function(report) {
          return String(report.status || 'Pending').toLowerCase() === value.toLowerCase();
        }).length;
      };
    %>

    <section class="records-page-heading">
      <div>
        <p class="page-eyebrow"><span></span> Your activity</p>
        <h1>My reports</h1>
        <p>Keep an eye on your submitted lost and found reports and see when their status changes.</p>
      </div>
      <a href="/report" class="page-primary-button">Create a report <span aria-hidden="true">→</span></a>
    </section>

    <section class="records-summary" aria-label="Report summary">
      <article class="records-summary-card records-summary-total">
        <span class="records-summary-mark" aria-hidden="true">01</span>
        <div><p>Total reports</p><strong><%= reportList.length %></strong></div>
      </article>
      <article class="records-summary-card records-summary-pending">
        <span class="records-summary-mark" aria-hidden="true">02</span>
        <div><p>In review</p><strong><%= reportStatusCount('pending') %></strong></div>
      </article>
      <article class="records-summary-card records-summary-approved">
        <span class="records-summary-mark" aria-hidden="true">03</span>
        <div><p>Approved</p><strong><%= reportStatusCount('approved') %></strong></div>
      </article>
    </section>

    <section class="table-wrap records-table-wrap">
      <% if (reportList.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th>Report Type</th>
              <th>Location</th>
              <th>Date Reported</th>
              <th>Status</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% reportList.forEach(function(report) {
              const status = String(report.status || 'Pending');
              const statusClass = status.toLowerCase().replace(/[^a-z]/g, '');
              const type = report.report_type || report.type || report.item_type || 'Not specified';
              const id = report.id || report.item_id || '';
              const date = report.created_at || report.date_reported || report.reported_at;
            %>
              <tr>
                <td>
                  <% if (report.image && /^\/uploads\/[a-f0-9-]+\.(jpg|png|webp)$/i.test(report.image)) { %>
                    <img class="report-thumbnail" src="<%= report.image %>"
                         alt="Photo of <%= report.item_name || report.title || 'reported item' %>">
                  <% } %>
                  <div class="item-name"><%= report.item_name || report.title || 'Unnamed Item' %></div>
                  <div class="muted">ID: <%= id || 'N/A' %></div>
                </td>
                <td>
                  <span class="badge <%= String(type).toLowerCase() === 'lost' ? 'lost' : (String(type).toLowerCase() === 'found' ? 'found' : '') %>">
                    <%= type %>
                  </span>
                </td>
                <td><%= report.location || report.found_location || 'Not specified' %></td>
                <td><%= date ? new Date(date).toLocaleDateString() : 'Not specified' %></td>
                <td><span class="badge <%= statusClass %>"><%= status %></span></td>
                <td>
                  <% if (id) { %>
                    <a class="view-link" href="/item/<%= id %>">View details →</a>
                  <% } else { %>
                    <span class="muted">Unavailable</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="records-empty-state">
          <span class="records-empty-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M7 3.75h7l4 4V20a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4.75a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M14 4v4h4M9 13h6M9 16.5h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            </svg>
          </span>
          <h2>No reports yet</h2>
          <p>Your submitted reports will appear here so you can track their progress.</p>
          <a href="/report" class="page-primary-button">Create your first report <span aria-hidden="true">→</span></a>
        </div>
      <% } %>
    </section>
  </main>

  <footer>© Campus Lost &amp; Found System</footer>
</body>
</html>
