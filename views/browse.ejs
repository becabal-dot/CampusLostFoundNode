<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Items | Campus Lost &amp; Found</title>
  <link rel="stylesheet" href="/css/app.css?v=5">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="browse-shell">
    <section class="browse-hero">
      <div class="browse-hero-copy">
        <p class="page-eyebrow"><span></span> Campus item directory</p>
        <h1>Find what you’ve been missing.</h1>
        <p>Explore approved found-item reports from around campus. A few details might help you reconnect with a lost belonging.</p>
      </div>
      <a class="page-primary-button" href="/report">Report an item <span aria-hidden="true">→</span></a>
      <div class="browse-hero-orb" aria-hidden="true"></div>
    </section>

    <section class="browse-results-header">
      <div>
        <p class="page-kicker">Explore listings</p>
        <h2>Recently reported items</h2>
      </div>
      <p>Use the filters to narrow down your search.</p>
    </section>

    <form class="browse-filter-panel" action="/browse" method="GET">
      <label class="browse-search-field" for="browse-search">
        <span class="browse-filter-label">Search items</span>
        <span class="browse-input-wrap">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/>
            <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <input id="browse-search" type="search" name="search"
                 placeholder="Try “wallet” or “umbrella”"
                 value="<%= typeof search !== 'undefined' && search ? search : '' %>">
        </span>
      </label>
      <label class="browse-category-field" for="browse-category">
        <span class="browse-filter-label">Category</span>
        <select id="browse-category" name="category">
          <option value="">All categories</option>
          <% if (typeof categories !== 'undefined' && Array.isArray(categories)) { %>
            <% categories.forEach(function(category) { %>
              <option value="<%= category %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === category) ? 'selected' : '' %>>
                <%= category %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </label>
      <button class="browse-search-button" type="submit">Search items</button>
    </form>

    <section class="browse-grid" aria-label="Found item listings">
      <% if (typeof items !== 'undefined' && Array.isArray(items) && items.length > 0) { %>
        <% items.forEach(function(item) { %>
          <article class="browse-item-card">
            <div class="browse-item-photo">
              <% if (item.image && /^\/uploads\/[a-f0-9-]+\.(jpg|png|webp)$/i.test(item.image)) { %>
                <img src="<%= item.image %>" alt="<%= item.item_name %>">
              <% } else { %>
                <span class="item-image-placeholder" aria-label="No item photo">No photo provided</span>
              <% } %>
              <span class="browse-type-badge"><%= item.report_type || 'Found' %></span>
            </div>
            <div class="browse-item-content">
              <p class="browse-item-category"><%= item.category_name || item.category || 'Uncategorized' %></p>
              <h3><%= item.item_name || item.title || 'Unnamed Item' %></h3>
              <p class="browse-item-description"><%= item.description || 'No description provided.' %></p>
              <div class="browse-item-meta">
                <span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.7"/>
                    <circle cx="12" cy="10" r="2.2" stroke="currentColor" stroke-width="1.7"/>
                  </svg>
                  <%= item.location || item.found_location || 'Location not specified' %>
                </span>
                <span>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="4" y="5.5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.7"/>
                    <path d="M8 3.5v4M16 3.5v4M4 10h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                  </svg>
                  <%= item.event_date ? new Date(item.event_date).toLocaleDateString() : (item.created_at ? new Date(item.created_at).toLocaleDateString() : 'Date not specified') %>
                </span>
              </div>
              <a class="browse-item-link" href="/item/<%= item.id || item.item_id %>">
                View item details <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="browse-empty-state">
          <span class="browse-empty-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/>
              <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </span>
          <h2>No matching items</h2>
          <p>Try a different search or category. New approved reports will show here.</p>
          <a class="page-secondary-button" href="/browse">Clear filters</a>
        </div>
      <% } %>
    </section>
  </main>

  <footer>© Campus Lost &amp; Found System</footer>
</body>
</html>
